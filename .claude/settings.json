{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrateur",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(supabase --version)",
      "Bash(supabase status*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset)",
      "Bash(supabase db reset --local*)",
      "Bash(supabase test db*)",
      "Bash(supabase migration new *)",
      "Bash(supabase migration list --local*)",
      "Bash(supabase gen types typescript --local*)",
      "Bash(supabase functions serve*)",
      "Bash(deno --version)",
      "Bash(deno test *)",
      "Bash(deno check *)",
      "Bash(deno lint *)",
      "Bash(deno fmt *)",
      "Bash(docker --version)",
      "Bash(docker info*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git tag *)",
      "Bash(git stash*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/*)",
      "PowerShell(npm run *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx eslint *)",
      "PowerShell(supabase status*)",
      "PowerShell(supabase start*)",
      "PowerShell(supabase stop*)",
      "PowerShell(supabase db reset)",
      "PowerShell(supabase test db*)",
      "PowerShell(supabase migration new *)",
      "PowerShell(supabase gen types typescript --local*)",
      "PowerShell(deno test *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git mv *)",
      "PowerShell(git tag *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File tools/*)"
    ],
    "ask": [
      "Agent(model:fable)"
    ],
    "deny": [
      "Bash(supabase db reset --linked*)",
      "PowerShell(supabase db reset --linked*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "Read(/node_modules/**)",
      "Read(/dist/**)",
      "Read(/supabase/.temp/**)",
      "Read(/supabase/functions/.env*)",
      "Read(/.env.production*)",
      "Agent(orchestrateur)",
      "Agent(fork)"
    ]
  }
}
